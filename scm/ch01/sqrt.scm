(load "../common/math.scm")

;; Square Root Guess Update Rule Using Average Damping
;;
;;   Guesses generated by the rule y' <- x / y may oscillate wildly and fail to approach the square root, whereas
;;   guesses generated by the rule y'' <- (x / y + y) / 2 using average damping approach the square root stably.
;;
;;   y = sqrt(x)
;;   y^2 = x
;;   y = x / y
;;   2y = x / y + y
;;   y = (x / y + y) / 2
;;
(define (sqrt-improve guess x)
  (average (/ x guess) guess))

;; Square Root by Iterating Until Reaching the Root Using Average Damping
(define (sqrt-with1 x good-enough?)
  (define (try guess)
    (if (good-enough? guess x)
        guess
        (try (sqrt-improve guess x))))
  (try 1.0))

(define sqrt-tolerance1 0.001)

;; WORST: Compute the square root of `x` using exact equality: y^2 = x,
;;        which causes a termination failure even for some ordinary numbers.
(define (sqrt1 x)
  (sqrt-with1 x (lambda (guess x) (= (square guess) x))))

;; WORSE: Compute the square root of `x` using absolute error: |y^2 - x| < tolerance,
;;        which causes an accuracy failure for very small numbers, and termination failure for very large numbers.
(define (sqrt2 x)
  (sqrt-with1 x (lambda (guess x) (< (abs_ (- (square guess) x)) sqrt-tolerance1))))

;; BAD: Compute the square root of `x` using relative error: |(y^2 - x) / x| < tolerance,
;;      which addresses the problem with very small and large numbers, but still suffers from an accuracy problem.
(define (sqrt3 x)
  (sqrt-with1 x (lambda (guess x) (< (abs_ (/ (- (square guess) x) x)) sqrt-tolerance1))))

;; Square Root by Iterating Until Reaching the Fixed Point Using Average Damping
(define (sqrt-with2 x good-enough?)
  (define (try guess)
    (let ((next-guess (sqrt-improve guess x)))
      (if (good-enough? guess next-guess)
          next-guess
          (try next-guess))))
  (try 1.0))

(define sqrt-tolerance2 0.00000000001)

;; GOOD: Compute the square root of `x` using exact equality: y = y_next,
;;       which resolves the problem with very small and large numbers, but may cause a cycle for some numbers.
(define (sqrt4 x)
  (sqrt-with2 x (lambda (guess next-guess) (= guess next-guess))))

;; BETTER: Compute the square root of `x` using absolute error: |y - y_next| < tolerance,
;;         which resolves the problem with very small and large numbers, but may suffer from an accuracy problem.
(define (sqrt5 x)
  (sqrt-with2 x (lambda (guess next-guess) (< (abs_ (- guess next-guess)) sqrt-tolerance2))))

;; BEST: Compute the square root of `x` using relative error: |(y - y_next) / y_next| < tolerance,
;;       which resolves the problem with very small and large numbers, but may suffer from an accuracy problem.
(define (sqrt6 x)
  (sqrt-with2 x (lambda (guess next-guess) (< (abs_ (/ (- guess next-guess) next-guess)) sqrt-tolerance2))))

;; Square Root by Iterating Until Reaching the Checked Fixed Point Using Average Damping
;; BEST+: Compute the square root of `x` using checked exact equality: y = y_next or y_next = y_prev,
;;        which resolves the problem with very small and large numbers, and detects a 2-cycle.
(define (sqrt7 x)
  (define (good-enough? guess next-guess prev-guess)
    (or (= guess next-guess)
        (= next-guess prev-guess)))
  (define (try guess prev-guess)
    (let ((next-guess (sqrt-improve guess x)))
      (if (good-enough? guess next-guess prev-guess)
          next-guess
          (try next-guess guess))))
  (try 1.0 1.0))

(define sqrt_ sqrt7)
