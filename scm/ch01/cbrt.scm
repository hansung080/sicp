(load "../common/math.scm")

;; Cube Root Guess Update Rule Using Weighted Average Damping
;;
;;   Guesses generated by the rule y' <- x / y^2 may oscillate wildly and fail to approach the cube root, whereas
;;   guesses generated by the rule y'' <- (x / y^2 + 2y) / 3 using weighted average damping approach the cube root
;;   stably.
;;
;;   y = cbrt(x)
;;   y^3 = x
;;   y = x / y^2
;;   3y = x / y^2 + 2y
;;   y = (x / y^2 + 2y) / 3
;;
(define (cbrt-improve guess x)
  (/ (+ (/ x (square guess))
        (* 2 guess))
     3))

;; Iterating Until Reaching the Root Using Weighted Average Damping
(define (cbrt-with1 x good-enough?)
  (define (try guess)
    (if (good-enough? guess x)
        guess
        (try (cbrt-improve guess x))))
  (try 1.0))

(define cbrt-tolerance1 0.001)

;; WORST: Compute the cube root of `x` using exact equality: y^3 = x,
;;        which causes a termination failure even for some ordinary numbers.
(define (cbrt1 x)
  (cbrt-with1 x (lambda (guess x) (= (cube guess) x))))

;; WORSE: Compute the cube root of `x` using absolute error: |y^3 - x| < tolerance,
;;        which causes an accuracy failure for very small numbers, and termination failure for very large numbers.
(define (cbrt2 x)
  (cbrt-with1 x (lambda (guess x) (< (abs_ (- (cube guess) x)) cbrt-tolerance1))))

;; BAD: Compute the cube root of `x` using relative error: |(y^3 - x) / x| < tolerance,
;;      which addresses the problem with very small and large numbers, but still suffers from an accuracy problem.
(define (cbrt3 x)
  (cbrt-with1 x (lambda (guess x) (< (abs_ (/ (- (cube guess) x) x)) cbrt-tolerance1))))

;; Iterating Until Reaching the Fixed Point Using Weighted Average Damping
(define (cbrt-with2 x good-enough?)
  (define (try guess)
    (let ((next-guess (cbrt-improve guess x)))
      (if (good-enough? guess next-guess)
          next-guess
          (try next-guess))))
  (try 1.0))

(define cbrt-tolerance2 0.00000000001)

;; GOOD: Compute the cube root of `x` using exact equality: y = y_next,
;;       which resolves the problem with very small and large numbers, but may cause a termination failure
;;       due to a cycle.
(define (cbrt4 x)
  (cbrt-with2 x (lambda (guess next-guess) (= guess next-guess))))

;; BETTER: Compute the cube root of `x` using absolute error: |y - y_next| < tolerance,
;;         which resolves the problem with very small and large numbers, but may cause an accuracy problem.
(define (cbrt5 x)
  (cbrt-with2 x (lambda (guess next-guess) (< (abs_ (- guess next-guess)) cbrt-tolerance2))))

;; BEST: Compute the cube root of `x` using relative error: |(y - y_next) / y_next| < tolerance,
;;       which resolves the problem with very small and large numbers, but may cause an accuracy problem.
(define (cbrt6 x)
  (cbrt-with2 x (lambda (guess next-guess) (< (abs_ (/ (- guess next-guess) next-guess)) cbrt-tolerance2))))

;; Iterating Until Reaching the Checked Fixed Point Using Weighted Average Damping
;;
;; BEST+: Compute the cube root of `x` using checked exact equality: y = y_next or y_next = y_prev,
;;        which resolves the problem with very small and large numbers, and detects a 2-cycle to allow termination.
(define (cbrt7 x)
  (define (good-enough? guess next-guess prev-guess)
    (or (= guess next-guess)
        (= next-guess prev-guess)))
  (define (try guess prev-guess)
    (let ((next-guess (cbrt-improve guess x)))
      (if (good-enough? guess next-guess prev-guess)
          next-guess
          (try next-guess guess))))
  (try 1.0 1.0))

(define cbrt cbrt7)
